{
  "name": "rahul-mehra-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:pages": "npm run build && wrangler pages dev dist --port 8788 --d1 BOOKINGS_DB",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "pmp:check": "node scripts/pmp-content-report.ts && node scripts/pmp-build-source-stats.ts && node scripts/pmp-write-reports.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.151.2"
  }
}
